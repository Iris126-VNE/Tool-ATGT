  "Outputs": [
    {
      "Id": "543d781928b2408bb7821451bba3663e",
      "Name": "[KET QUA THUC THI] XEM SO LUONG & KHOANG MA LOI",
      "Type": "string",
      "InitialValue": "THANH CONG: Da rai 56 dot Ton Luon Song Ho Lan chuan Structural Framing Beam (KHOANG CACH COT DEU NHAU CHUAN 2.00M, khong trung family)!\n- Tong chieu dai rai: 336.00 m | So cot: 112 cot (Buoc cot = 2.00 m deu nhau 100%)\n- Vi tri ben tuyen: Trai\n- Buoc dot L = 6.00 m (Moi dot gom 2 cot, noi tiep khit khau) | Dinh H = 0.80 m | Offset = 0.00 m\n- Khoang ma LOI BIM: [TS-KM52-0001 -> TS-KM52-0056]\n- Goi thau: Goi thau XL01 | Km52+000 - Km60+000\n- Huong mat ton: Tu dong quay vao long duong (traffic face inward).",
      "Description": "Visualizes a node's output"
    }
